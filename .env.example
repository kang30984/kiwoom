# 이 파일을 server/.env 로 복사해서 쓰세요.
#   cp .env.example server/.env
# server/.env 는 .gitignore 에 들어 있습니다. 시크릿키를 넣어도 커밋되지 않습니다.

# ── 데모 모드 ─────────────────────────────────────────────────
# true  : 키움에 접속하지 않고 서버가 가짜 시세를 만들어 흘려보냅니다.
#         앱키 없이 전체 화면을 확인할 수 있습니다. 실제 시세가 아닙니다.
# false : 키움 실서버/모의서버에 접속합니다. 아래 앱키가 필요합니다.
#
# 이 줄을 지우면 앱키 유무로 자동 판단합니다 (키가 없으면 데모).
DEMO=true

# ── 키움 오픈API ──────────────────────────────────────────────
# 키움증권 로그인 → 오픈API 신청 → 앱키·시크릿키 발급
# DEMO=true 인 동안에는 비워 두어도 됩니다.
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=

# true 면 모의투자 서버(mockapi.kiwoom.com), false 면 실서버(api.kiwoom.com).
# 처음에는 모의투자로 확인하는 편이 안전합니다.
KIWOOM_MOCK=true

# ── 서버 ──────────────────────────────────────────────────────
# 4000 번이 이미 쓰이고 있으면(EADDRINUSE) 다른 값으로 바꾸세요.
# 바꾸면 web/vite.config.js 의 프록시 대상도 함께 맞춰야 합니다.
PORT=4000

# 키움 REST 호출 사이 최소 간격(ms). 호출 한도에 걸리면 늘리세요.
MIN_REQUEST_GAP_MS=250

# ── 미국 시세 ─────────────────────────────────────────────────
# demo       : 키 없이 가짜 데이터 (기본값)
# twelvedata : https://twelvedata.com 무료 가입 후 키 발급 (15분 지연)
US_PROVIDER=demo
US_API_KEY=

# 공급자의 분당 호출 한도. Twelve Data 무료 티어는 8회/분입니다.
US_RATE_PER_MIN=8

# ── 디버깅 ────────────────────────────────────────────────────
# development 로 띄우면 /api/quote/:code 응답에 키움 원본(raw)이 함께 담깁니다.
# 실제 필드명을 확인할 때 씁니다.
# NODE_ENV=development
