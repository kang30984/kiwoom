# 이 파일을 server/.env 로 복사해서 쓰세요.
#   cp .env.example server/.env
# server/.env 는 .gitignore 에 들어 있습니다. 시크릿키를 넣어도 커밋되지 않습니다.

# ── 데모 모드 ─────────────────────────────────────────────────
# true  : 키움에 접속하지 않고 서버가 가짜 시세를 만들어 흘려보냅니다.
#         앱키 없이 전체 화면을 확인할 수 있습니다. 실제 시세가 아닙니다.
# false : 키움 실서버/모의서버에 접속합니다. 아래 앱키가 필요합니다.
#
# 이 줄을 지우면 앱키 유무로 자동 판단합니다 (키가 없으면 데모).
DEMO=true

# ── 키움 오픈API ──────────────────────────────────────────────
# 키움증권 로그인 → 오픈API 신청 → 앱키·시크릿키 발급
# DEMO=true 인 동안에는 비워 두어도 됩니다.
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=

# true 면 모의투자 서버(mockapi.kiwoom.com), false 면 실서버(api.kiwoom.com).
# 처음에는 모의투자로 확인하는 편이 안전합니다.
KIWOOM_MOCK=true

# ── 서버 ──────────────────────────────────────────────────────
# 4000 번이 이미 쓰이고 있으면(EADDRINUSE) 다른 값으로 바꾸세요.
# 바꾸면 web/vite.config.js 의 프록시 대상도 함께 맞춰야 합니다.
PORT=4000

# 키움 REST 호출 사이 최소 간격(ms). 호출 한도에 걸리면 늘리세요.
MIN_REQUEST_GAP_MS=250

# ── 미국 시세 ─────────────────────────────────────────────────
# demo       : 키 없이 가짜 데이터 (기본값)
# twelvedata : https://twelvedata.com 무료 가입 후 키 발급 (15분 지연)
US_PROVIDER=demo
US_API_KEY=

# 공급자의 분당 호출 한도. Twelve Data 무료 티어는 8회/분입니다.
US_RATE_PER_MIN=8

# ── 수급 (체결강도 · 프로그램매매) ────────────────────────────
#
# ⚠ 아래 api-id / FID 는 검증되지 않았습니다.
#   openapi.kiwoom.com 문서와 대조하고, 다르면 이 줄들로 덮어쓰세요.
#   코드를 고칠 필요는 없습니다. 잘못된 api-id 는 오류가 아니라
#   return_code != 0 으로 조용히 실패하므로 반드시 확인해야 합니다.
#
#   DEMO=true 인 동안에는 이 값이 전혀 쓰이지 않습니다.
#   화면·UI 검증은 api-id 를 맞추기 전에 끝낼 수 있습니다.
#
# ▸ 쓰는 방법: 문서에서 확인한 줄만 # 를 지우고 값을 넣으세요.
#   확인하지 않은 줄은 # 를 붙인 채로 두면 코드 기본값이 쓰입니다.
#   `TR_STRENGTH_TIME=` 처럼 값 없이 두어도 기본값으로 떨어지지만,
#   무엇을 확인했는지 헷갈리므로 주석으로 두는 편이 낫습니다.
#
#   현재 무엇이 쓰이고 있는지: http://localhost:4000/api/flow/stats
#   source 가 'env' 면 내가 넣은 값, 'default(미검증)' 면 추측값입니다.
#
# 체결강도추이 (시간별 / 일별)
# TR_STRENGTH_TIME=ka10046
# TR_STRENGTH_TIME_PATH=/api/dostk/mrkcond
# TR_STRENGTH_DAY=ka10047
# TR_STRENGTH_DAY_PATH=/api/dostk/mrkcond
#
# 프로그램매매 (종목별 / 시장 단위)
# TR_PROGRAM_STOCK=ka90013
# TR_PROGRAM_STOCK_PATH=/api/dostk/stkinfo
# TR_PROGRAM_MARKET=ka90005
# TR_PROGRAM_MARKET_PATH=/api/dostk/mrkcond
#
# 실시간 0B 주식체결의 체결강도 FID. 틀리면 값이 null 로만 옵니다.
# FID_STRENGTH=228

# 프로그램매매 금액 필드의 원본 단위(원).
#
# 키움은 TR 마다 금액 단위가 다릅니다 — 원 / 천원 / 백만원이 섞여 있습니다.
# 잘못 잡으면 100만 배 틀린 값이 나오는데, 숫자가 크니 오히려 그럴듯해 보여서
# 눈으로 잡히지 않습니다. 실제 응답을 한 번 보고 맞추세요.
#   1 = 원 그대로 / 1000 = 천원 / 1000000 = 백만원
# 화면에 '원본 단위 OO 가정' 이 함께 표시되므로 틀렸는지 바로 보입니다.
PROGRAM_AMOUNT_UNIT=1000000

# 데모에서 '미집계' 상태를 강제합니다. 프로그램매매가 아직 집계되지 않았을 때
# 화면이 '0' 이 아니라 '미집계' 로 표시되는지 확인할 때 켜세요.
# DEMO_FLOW_EMPTY=true

# ── 디버깅 ────────────────────────────────────────────────────
# development 로 띄우면 /api/quote/:code · /api/strength/:code · /api/program/:code
# 응답에 키움 원본(raw)이 함께 담깁니다. 실제 필드명·금액 단위를 확인할 때 씁니다.
#
# 캐시가 실제로 호출을 막고 있는지, 검증 안 된 api-id 가 무엇인지는
# http://localhost:4000/api/flow/stats 에서 볼 수 있습니다.
# NODE_ENV=development
